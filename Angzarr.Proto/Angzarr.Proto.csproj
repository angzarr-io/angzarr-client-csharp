<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.25.1" />
        <PackageReference Include="Google.Api.CommonProtos" Version="2.15.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
        <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!--
          angzarr-project relocated proto files from proto/angzarr/*.proto
          to proto/angzarr_client/proto/angzarr/*.proto. Generated namespace
          stays Angzarr.* via the unchanged `csharp_namespace` option, so
          source code is untouched — only the file glob moves.
        -->
        <Protobuf
            Include="../angzarr-project/proto/angzarr_client/proto/angzarr/*.proto"
            GrpcServices="Both"
            ProtoRoot="../angzarr-project/proto"
        />
    </ItemGroup>
</Project>
