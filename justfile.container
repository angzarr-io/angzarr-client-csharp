# C# client library - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`

default:
    @just --list

# Proto regen executor. Builds Angzarr.Proto.csproj which triggers the
# Grpc.Tools MSBuild task to emit *.cs into
# Angzarr.Proto/obj/<Configuration>/<TargetFramework>/Protos/. See the host
# justfile's `generate-proto` orchestration for the mtime-guarded entry
# point. Per project_proto_generation_model the build-tool integration is
# the EXECUTOR but not the TRIGGER — `just` owns the trigger.
generate-proto-force:
    dotnet build Angzarr.Proto/Angzarr.Proto.csproj

# Legacy alias.
proto: generate-proto-force

build:
    cd Angzarr.Client && dotnet build

test:
    dotnet test

coverage:
    dotnet test --collect:"XPlat Code Coverage"

# Format check (dotnet format)
fmt:
    dotnet format --verify-no-changes

# Auto-format code
fmt-fix:
    dotnet format

# Run Stryker.NET mutation testing
mutation-test:
    dotnet tool restore
    dotnet stryker

pack:
    cd Angzarr.Client && dotnet pack

publish:
    cd Angzarr.Client && dotnet nuget push bin/Release/*.nupkg --api-key $NUGET_API_KEY --source https://api.nuget.org/v3/index.json

# Per-function cyclomatic complexity (lizard). Scans the hand-written client
# library; build output (obj/bin) and the generated Angzarr.Proto project are
# excluded. Single-quoted globs so the host shell doesn't expand them.
# Leading `-` keeps this a report — it does NOT fail the build.
LIZARD_EXCLUDES := "-x '*/obj/*' -x '*/bin/*' -x '*/Angzarr.Proto/*'"
complexity *ARGS:
    -lizard -l csharp -C 15 {{LIZARD_EXCLUDES}} {{ if ARGS == "" { "Angzarr.Client" } else { ARGS } }}
