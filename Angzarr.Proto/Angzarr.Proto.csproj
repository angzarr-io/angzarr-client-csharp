<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.25.1" />
        <PackageReference Include="Google.Api.CommonProtos" Version="2.15.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
        <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!--
          angzarr-project v1 move: protos now live under
          proto/angzarr_client/proto/angzarr/v1/. csharp_namespace stays
          "Angzarr" (option in the .proto files is unchanged), so the
          generated namespace stays Angzarr.* and source code is
          untouched — only the file glob moves.
        -->
        <Protobuf
            Include="../angzarr-project/proto/angzarr_client/proto/angzarr/v1/*.proto"
            GrpcServices="Both"
            ProtoRoot="../angzarr-project/proto"
        />
        <!--
          PR #11 (angzarr-project): types.proto imports sererr/v1/sererr.proto
          for EventProcessingFailedDetails.stack_trace. sererr lives at
          proto/sererr/v1/ in the submodule. This <Protobuf> include is
          gated on the file being present (resolves only after the
          angzarr-project pointer is bumped past a8683ed to land PR #11).
          Per hard rule "Don't bump angzarr-project submodule pointer"
          in the C# migration, the gate is `Condition="Exists(..)"` so the
          current pinned 4f15da3 keeps compiling.
        -->
        <Protobuf
            Condition="Exists('../angzarr-project/proto/sererr/v1/sererr.proto')"
            Include="../angzarr-project/proto/sererr/v1/sererr.proto"
            GrpcServices="None"
            ProtoRoot="../angzarr-project/proto"
        />
    </ItemGroup>
</Project>
