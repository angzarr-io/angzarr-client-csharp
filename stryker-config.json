{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "Angzarr.Client.csproj",
    "test-projects": ["Angzarr.Client.Tests/Angzarr.Client.Tests.csproj"],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 0
    },
    "mutate": [
      "**/*.cs",
      "!**/obj/**/*.cs",
      "!**/bin/**/*.cs"
    ],
    "reporters": ["json", "progress"]
  }
}
